      "name": "01 Registrar socio PREMIUM",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ana Gomez\",\n  \"email\": \"ana@example.com\",\n  \"plan\": \"PREMIUM\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('memberId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
